PORT=3121
HOST=127.0.0.1
# The real database — what `bun run start` serves. `bun run dev` and `bun run demo`
# ignore this and pin themselves to data/dev.sqlite, so invented demo people can
# never land among real records. An inline DB_PATH beats this file.
DB_PATH=data/121.sqlite
BASE_URL=http://127.0.0.1:3121
DEFAULT_LOCALE=ru
TZ=Europe/Moscow
